[Unit]
Description=Back up the AOHUANG Listing v2 PostgreSQL database
After=postgresql@14-main.service
Requires=postgresql@14-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/opt/miaoshou-listing-v2/backup-miaoshou-listing-v2.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/miaoshou-listing-v2
